# Primary (production) application database - pooled connection
DATABASE_URL="postgresql://USER:PASSWORD@PROD-ENDPOINT-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Primary (production) database - direct connection for migrations
# Comment this line to make Prisma migrations use TEST_DIRECT_URL
DIRECT_URL="postgresql://USER:PASSWORD@PROD-ENDPOINT.REGION.aws.neon.tech/DB?sslmode=require"

# Isolated testing database - pooled connection
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST-ENDPOINT-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Isolated testing database - direct connection for migrations
TEST_DIRECT_URL="postgresql://USER:PASSWORD@TEST-ENDPOINT.REGION.aws.neon.tech/DB?sslmode=require"

# Server-only JWT signing secret
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
