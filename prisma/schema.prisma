// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// Generate Prisma Client into our Next.js source directory.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Database connection URLs are configured in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// Enums
// ---------------------------------------------------------

enum ResourceType {
  MEETING_ROOM
  EQUIPMENT
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

// ---------------------------------------------------------
// User
// Registered users can create resources and reservations.
// ---------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  // Resources created by this user.
  createdResources Resource[] @relation("ResourceCreator")

  // Reservations made by this user.
  reservations Reservation[]
}

// ---------------------------------------------------------
// Resource
// Any authenticated user can manage resources.
// createdById tracks attribution, not authorization.
// ---------------------------------------------------------

model Resource {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  type        ResourceType
  location    String
  capacity    Int?
  description String?
  isActive    Boolean      @default(true)

  createdById String @db.Uuid
  createdBy   User   @relation("ResourceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Preserve booking history when a resource is deactivated.
  reservations Reservation[]

  @@index([createdById])
  @@index([isActive])
}

// ---------------------------------------------------------
// Reservation
// Only the creator may edit or cancel their future booking.
// Confirmed reservations must not overlap for one resource.
// ---------------------------------------------------------

model Reservation {
  id String @id @default(uuid()) @db.Uuid

  userId     String @db.Uuid
  resourceId String @db.Uuid

  purpose String
  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  status    ReservationStatus @default(CONFIRMED)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  // Keep ownership and resource history intact.
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@index([resourceId, startAt])
  @@index([userId, startAt])
  @@index([status, startAt])
}
